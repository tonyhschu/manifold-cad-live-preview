{
  "name": "@manifold-studio/configurator",
  "version": "0.3.4",
  "type": "module",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "manifold-studio": "dist/cli/index.js"
  },
  "files": [
    "dist/lib",
    "dist/cli",
    "dist/pipeline-runtime",
    "templates"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:cli && npm run build:pipeline-runtime",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:cli": "vite build --config vite.config.cli.ts",
    "build:pipeline-runtime": "mkdir -p dist/pipeline-runtime && tsc src/pipeline-runtime/types.ts --outDir dist/pipeline-runtime --target ES2022 --module ESNext --declaration --moduleResolution bundler --skipLibCheck",
    "pretest": "node ../../scripts/check-build-before-test.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/model-viewer": "^3.3.0",
    "@manifold-studio/wrapper": "^0.3.4",
    "@preact/signals": "^2.0.4",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "glob": "^10.3.10",
    "tweakpane": "^4.0.5",
    "vite": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/ui": "^1.0.0",
    "happy-dom": "^12.0.0",
    "typescript": "^5.0.2",
    "vitest": "^1.0.0"
  }
}
