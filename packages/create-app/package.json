{
  "name": "@manifold-studio/create-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Scaffolding tool for creating Manifold Studio projects",
  "keywords": ["manifold", "3d", "cad", "scaffolding", "cli"],
  "bin": {
    "create-app": "./bin/index.js"
  },
  "files": ["bin", "templates"],
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose",
    "test:template": "vitest run tests/integration/template-generation.test.ts --reporter=verbose",
    "test:package": "vitest run tests/integration/package-validation.test.ts --reporter=verbose",
    "test:install": "vitest run tests/integration/installation.test.ts --reporter=verbose",
    "test:build": "vitest run tests/integration/build-system.test.ts --reporter=verbose",
    "test:build-pipeline": "vitest run tests/integration/build-system.test.ts -t 'Pipeline Build' --reporter=verbose",
    "test:build-ui": "vitest run tests/integration/build-system.test.ts -t 'UI Build' --reporter=verbose",
    "test:build-combined": "vitest run tests/integration/build-system.test.ts -t 'Combined Build' --reporter=verbose",
    "test:hmr": "vitest run tests/integration/hmr-system.test.ts --reporter=verbose",
    "test:pipeline": "vitest run tests/integration/hmr-system.test.ts -t 'Pipeline System' --reporter=verbose",
    "test:v3-validation": "vitest run tests/integration/hmr-system.test.ts --reporter=verbose",
    "test:integration": "vitest run tests/integration/ --reporter=verbose",
    "dev": "concurrently \"npm run dev:pipeline\" \"npm run dev:ui\"",
    "dev:pipeline": "vite build --config vite.pipeline.config.ts --watch",
    "dev:ui": "vite",
    "build:pipeline": "vite build --config vite.pipeline.config.ts && npm run generate:manifest",
    "build:ui": "vite build",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "handlebars": "^4.7.0",
    "manifold-3d": "^3.1.1"
  },
  "devDependencies": {
    "typescript": "^5.0.2",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "concurrently": "^8.0.0",
    "tsx": "^4.0.0",
    "vite": "^4.4.5",
    "jsdom": "^24.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyhschu/manifold-cad-live-preview.git",
    "directory": "packages/create-app"
  },
  "author": "Tony Chu <tonyhschu@gmail.com>",
  "license": "MIT"
}
