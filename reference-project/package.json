{
  "name": "reference-project",
  "version": "1.0.0",
  "type": "module",
  "description": "A Manifold Studio project with font loading capabilities",
  "files": [
    "components/**/*",
    "lib/**/*",
    "assets/**/*",
    "*.ts",
    "*.js",
    "*.json"
  ],
  "scripts": {
    "dev": "manifold-studio dev",
    "dev:local": "npm run build:deps && node ../packages/configurator/dist/cli/index.js dev",
    "build:deps": "cd .. && npm run build:dev-deps",
    "build": "echo 'Build not needed - CLI handles compilation'",
    "test": "vitest"
  },
  "dependencies": {
    "manifold-3d": "^3.1.1",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@manifold-studio/configurator": "file:../packages/configurator",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.2",
    "vitest": "^1.0.0"
  }
}
