{
  "name": "manifold-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @manifold-studio/wrapper && npm run build --workspace @manifold-studio/typeface && npm run build --workspace @manifold-studio/configurator && npm run build --workspace @manifold-studio/create-app",
    "pretest": "node scripts/check-build-before-test.js && node scripts/check-port-before-integration.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:all": "node scripts/check-port-before-integration.js && npm run test --workspaces",
    "test:wrapper": "npm run test --workspace @manifold-studio/wrapper",
    "test:configurator": "npm run test --workspace @manifold-studio/configurator",
    "test:create-app": "npm run test --workspace @manifold-studio/create-app",
    "test:integration": "node scripts/check-build-before-test.js && node scripts/check-port-before-integration.js && npx vitest run tests/integration/",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:report": "npx playwright show-report",
    "dev": "npm run dev --workspace @manifold-studio/wrapper & npm run dev:configurator",
    "devAll": "REPO_HMR=true npm run dev --workspace @manifold-studio/wrapper & REPO_HMR=true npm run dev:configurator",
    "dev:libs": "concurrently \"npm run dev:wrapper-lib\" \"npm run dev:configurator-lib\"",
    "dev:wrapper": "npm run dev --workspace @manifold-studio/wrapper",
    "dev:wrapper-lib": "cd packages/wrapper && npm run dev",
    "dev:configurator": "npm run dev --workspace @manifold-studio/configurator",
    "dev:configurator-lib": "cd packages/configurator && npm run build:lib -- --watch",
    "dev:create-app": "npm run dev --workspace @manifold-studio/create-app",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@playwright/test": "^1.54.1",
    "concurrently": "^8.0.0",
    "typescript": "^5.0.2",
    "vitest": "^1.0.0"
  }
}
